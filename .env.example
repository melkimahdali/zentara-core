# Salin ke .env lalu isi. Jangan commit file .env.
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
# Database: default SQLite di data/app.db. Untuk PostgreSQL: postgres://user:pass@host:5432/db
# (lihat README bagian Database untuk mengganti ke PostgreSQL)
DATABASE_URL=file:./data/app.db
# Akun admin yang dibuat oleh `zentara db:seed` (password wajib diisi di production)
SEED_ADMIN_EMAIL=admin@zentara.test
SEED_ADMIN_PASSWORD=
# Minimal 32 karakter. Buat dengan: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# --- Zentara AI (zentara "perintah dalam bahasa biasa") ---
# Provider utama: Claude
ANTHROPIC_API_KEY=
# Opsional: OmniRoute (gateway lokal, fallback bila kredit habis)
# OMNIROUTE_URL=http://localhost:20128/v1
# OMNIROUTE_MODEL=
# OMNIROUTE_API_KEY=
# Opsional: Ollama (model lokal/offline)
# OLLAMA_URL=http://localhost:11434/v1
# OLLAMA_MODEL=
# Mode persetujuan: ask (default) atau auto
# ZENTARA_AI_MODE=ask
