# Salin ke .env lalu isi (create-zentara sudah membuatkan .env). Jangan commit file .env.
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
# Database: default SQLite di data/app.db. Untuk PostgreSQL: postgres://user:pass@host:5432/db
# (lihat README bagian Database untuk mengganti ke PostgreSQL)
DATABASE_URL=file:./data/app.db
# Akun admin yang dibuat oleh `zentara db:seed` (password wajib diisi di production)
SEED_ADMIN_EMAIL=admin@zentara.test
SEED_ADMIN_PASSWORD=
# Minimal 32 karakter. Buat dengan: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# Email (sendMail). Tanpa MAIL_URL, email hanya dicetak ke log saat pengembangan (disimpan di .zentara/mail).
# MAIL_URL=smtp://user:password@smtp.example.com:587
# MAIL_FROM="Nama Aplikasi <halo@example.com>"

# --- Zentara AI (atau jalankan: npx zentara ai:setup) ---
# Default: OmniRoute, AI gratis tanpa API key. Pasang sekali: npm install -g omniroute
# (npx zentara menawarkan menjalankannya di latar belakang). Model "auto" memilih provider gratis.
# OMNIROUTE_URL=http://localhost:20128/v1
# OMNIROUTE_MODEL=auto
# OMNIROUTE_API_KEY=
# Provider lain yang key-nya terisi otomatis masuk rantai fallback (urutan: ZENTARA_AI_ORDER=omniroute,openai,claude)
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1
# GEMINI_API_KEY=
# GROQ_API_KEY=
# DEEPSEEK_API_KEY=
# OPENROUTER_API_KEY=
# Ollama (model lokal & offline) otomatis dicoba bila berjalan
# OLLAMA_URL=http://localhost:11434/v1
# OLLAMA_MODEL=qwen3-coder
# ZENTARA_AI_MODE=ask
