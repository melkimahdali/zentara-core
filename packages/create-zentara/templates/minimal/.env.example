# Salin ke .env lalu isi (create-zentara sudah membuatkan .env). Jangan commit file .env.
NODE_ENV=development
PORT=3000
# --- Zentara AI: isi API key provider yang Anda pakai (atau jalankan: npx zentara ai:setup) ---
# Provider yang key-nya terisi otomatis masuk rantai fallback. Urutan: ZENTARA_AI_ORDER=openai,claude,ollama
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1
# GEMINI_API_KEY=
# GROQ_API_KEY=
# DEEPSEEK_API_KEY=
# OPENROUTER_API_KEY=
# Lokal (tanpa key): OmniRoute & Ollama otomatis dicoba bila berjalan
# OMNIROUTE_URL=http://localhost:20128/v1
# OLLAMA_URL=http://localhost:11434/v1
# OLLAMA_MODEL=qwen3-coder
# ZENTARA_AI_MODE=ask
