# Copy to .env and fill it in (create-zentara already created .env for you). Never commit .env.
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
# Database: SQLite in data/app.db by default. For PostgreSQL: postgres://user:pass@host:5432/db
# (see the Database section of the docs to switch to PostgreSQL)
DATABASE_URL=file:./data/app.db
# Admin account created by `zentara db:seed` (the password is required in production)
SEED_ADMIN_EMAIL=admin@zentara.test
SEED_ADMIN_PASSWORD=
# At least 32 characters. Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# --- Zentara AI (or run: npx zentara ai:setup) ---
# Default: OmniRoute, free AI with no API key. Install once: npm install -g omniroute
# (npx zentara offers to run it in the background). The "auto" model picks a free provider.
# OMNIROUTE_URL=http://localhost:20128/v1
# OMNIROUTE_MODEL=auto
# OMNIROUTE_API_KEY=
# Other providers with a key are added to the fallback chain automatically (order: ZENTARA_AI_ORDER=omniroute,openai,claude)
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1
# GEMINI_API_KEY=
# GROQ_API_KEY=
# DEEPSEEK_API_KEY=
# OPENROUTER_API_KEY=
# Ollama (local & offline models) is tried automatically when running
# OLLAMA_URL=http://localhost:11434/v1
# OLLAMA_MODEL=qwen3-coder
# ZENTARA_AI_MODE=ask
