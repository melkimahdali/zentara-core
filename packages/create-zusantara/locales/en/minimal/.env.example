# Copy to .env and fill it in (create-zusantara already created .env for you). Never commit .env.
NODE_ENV=development
PORT=3000
# --- Zusantara AI (or run: npx zusantara ai:setup) ---
# Default: OmniRoute, free AI with no API key. Install once: npm install -g omniroute
# (npx zusantara offers to run it in the background). The "auto" model picks a free provider.
# OMNIROUTE_URL=http://localhost:20128/v1
# OMNIROUTE_MODEL=auto
# OMNIROUTE_API_KEY=
# Other providers with a key are added to the fallback chain automatically (order: ZUSANTARA_AI_ORDER=omniroute,openai,claude)
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1
# GEMINI_API_KEY=
# GROQ_API_KEY=
# DEEPSEEK_API_KEY=
# OPENROUTER_API_KEY=
# Ollama (local & offline models) is tried automatically when running
# OLLAMA_URL=http://localhost:11434/v1
# OLLAMA_MODEL=qwen3-coder
# ZUSANTARA_AI_MODE=ask
